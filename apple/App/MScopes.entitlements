<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  Direct-distribution / local-run entitlements.
	  Audio input is required under the hardened runtime to capture audio.
	  NOTE: no App Sandbox here — a system-wide CoreAudio process tap is not
	  compatible with the App Store sandbox. An App Store target would need a
	  different (sandbox-legal) capture strategy. See repo README.
	-->
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
